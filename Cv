<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#070b14;
    color:#f8fafc;
    transition:.35s;
}

/* =========================
   LIGHT MODE
========================= */

body.light{
    background:#eef2ff;
    color:#111827;
}

body.light .navbar,
body.light .card,
body.light .hero,
body.light .project,
body.light .certificate,
body.light .stat{
    background:#ffffff;
    color:#111827;
    border-color:#dbe3f0;
}

body.light p{
    color:#475569;
}

body.light .nav-links a{
    color:#334155;
}

/* =========================
   BACKGROUND
========================= */

.bg-orb{
    position:fixed;
    border-radius:50%;
    filter:blur(80px);
    opacity:.25;
    z-index:-1;
}

.orb1{
    width:300px;
    height:300px;
    background:#2563eb;
    top:50px;
    left:-100px;
}

.orb2{
    width:300px;
    height:300px;
    background:#9333ea;
    right:-100px;
    top:400px;
}

.orb3{
    width:250px;
    height:250px;
    background:#06b6d4;
    left:30%;
    bottom:-100px;
}

/* =========================
   NAVBAR
========================= */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;

    backdrop-filter:blur(15px);

    background:rgba(7,11,20,.8);
    border-bottom:1px solid #1e293b;

    padding:15px 5%;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:22px;
    font-weight:900;
}

.logo span{
    color:#60a5fa;
}

.nav-links{
    display:flex;
    gap:18px;
    flex-wrap:wrap;
}

.nav-links a{
    text-decoration:none;
    color:#cbd5e1;
    font-size:14px;
    transition:.2s;
}

.nav-links a:hover{
    color:#60a5fa;
}

/* =========================
   CONTAINER
========================= */

.container{
    width:90%;
    max-width:1150px;
    margin:35px auto 70px;
}

/* =========================
   HERO
========================= */

.hero{
    padding:50px;
    border:1px solid #263246;
    border-radius:28px;

    background:linear-gradient(
        135deg,
        #111827,
        #172554
    );

    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:30px;

    box-shadow:0 25px 70px rgba(0,0,0,.35);
}

.hero h1{
    font-size:58px;
    line-height:1.1;
}

.gradient{
    background:linear-gradient(90deg,#60a5fa,#a78bfa,#22d3ee);
    -webkit-background-clip:text;
    color:transparent;
}

.subtitle{
    margin-top:12px;
    font-size:18px;
    color:#cbd5e1;
}

.tag{
    display:inline-block;
    margin-top:18px;
    background:#1d4ed8;
    color:white;
    padding:8px 15px;
    border-radius:999px;
    font-size:13px;
}

.hero-buttons{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:25px;
}

button{
    border:none;
    cursor:pointer;
    font-weight:700;
}

.btn{
    padding:12px 18px;
    border-radius:12px;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-3px);
}

.primary{
    background:#2563eb;
    color:white;
}

.secondary{
    background:#1e293b;
    color:#e2e8f0;
}

.avatar{
    width:180px;
    height:180px;

    flex-shrink:0;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:75px;

    background:linear-gradient(
        135deg,
        #60a5fa,
        #a78bfa
    );

    box-shadow:
        0 0 40px rgba(96,165,250,.35);

    animation:float 3s ease-in-out infinite;
}

@keyframes float{
    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-10px);
    }
}

/* =========================
   GRID
========================= */

.grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:22px;
    margin-top:22px;
}

.card{
    background:#111827;
    border:1px solid #263246;
    border-radius:20px;
    padding:28px;

    transition:.25s;
}

.card:hover{
    transform:translateY(-5px);
    border-color:#3b82f6;
    box-shadow:0 15px 40px rgba(0,0,0,.2);
}

.card h2{
    margin-bottom:18px;
    color:#60a5fa;
}

.card p{
    color:#cbd5e1;
    margin-bottom:9px;
}

/* =========================
   STATS
========================= */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-top:22px;
}

.stat{
    background:#111827;
    border:1px solid #263246;
    border-radius:18px;
    padding:22px;
    text-align:center;
}

.stat-number{
    font-size:34px;
    font-weight:900;
    color:#60a5fa;
}

.stat-label{
    margin-top:6px;
    font-size:13px;
    color:#94a3b8;
}

/* =========================
   SKILLS
========================= */

.skill{
    margin-bottom:18px;
}

.skill-top{
    display:flex;
    justify-content:space-between;
    margin-bottom:7px;
}

.bar{
    height:10px;
    border-radius:20px;
    background:#1e293b;
    overflow:hidden;
}

.fill{
    height:100%;
    width:0;
    border-radius:20px;
    background:linear-gradient(
        90deg,
        #60a5fa,
        #a78bfa
    );

    transition:width 1.5s;
}

/* =========================
   CERTIFICATES
========================= */

.certificate{
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:15px;
    margin-bottom:10px;

    border:1px solid #263246;
    border-radius:14px;

    background:#0f172a;
}

.certificate small{
    color:#60a5fa;
}

/* =========================
   PROJECT
========================= */

.project{
    padding:18px;
    border:1px solid #263246;
    border-radius:15px;
    background:#0f172a;
    margin-bottom:14px;
}

.project h3{
    color:#f8fafc;
    margin-bottom:7px;
}

.project p{
    font-size:14px;
}

.project button{
    margin-top:10px;
}

/* =========================
   TIMELINE
========================= */

.timeline{
    border-left:3px solid #3b82f6;
    padding-left:22px;
}

.timeline-item{
    position:relative;
    margin-bottom:25px;
}

.timeline-item::before{
    content:"";
    position:absolute;

    left:-29px;
    top:4px;

    width:12px;
    height:12px;

    border-radius:50%;
    background:#60a5fa;
}

.timeline-item small{
    color:#60a5fa;
}

.timeline-item h3{
    margin-top:4px;
}

/* =========================
   QUOTE
========================= */

.quote{
    padding:18px;

    background:#0f172a;

    border-left:4px solid #60a5fa;

    border-radius:12px;

    color:#cbd5e1;

    font-style:italic;

    margin-top:15px;
}

/* =========================
   TERMINAL
========================= */

.terminal{
    background:#020617;
    border:1px solid #1e293b;

    border-radius:15px;

    padding:20px;

    font-family:Consolas,monospace;

    color:#22c55e;
}

.terminal span{
    color:#60a5fa;
}

/* =========================
   FAQ
========================= */

details{
    background:#0f172a;
    border:1px solid #263246;

    margin-bottom:10px;
    border-radius:12px;

    padding:15px;

    cursor:pointer;
}

summary{
    font-weight:700;
}

details p{
    margin-top:10px;
}

/* =========================
   CONTACT
========================= */

.contact-buttons{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.contact-buttons button{
    padding:12px 16px;
    border-radius:12px;
    background:#1e293b;
    color:#e2e8f0;
}

/* =========================
   FOOTER
========================= */

footer{
    text-align:center;
    color:#64748b;
    margin-top:35px;
}

/* =========================
   MODAL
========================= */

.modal{
    display:none;

    position:fixed;
    inset:0;

    background:rgba(0,0,0,.75);

    align-items:center;
    justify-content:center;

    z-index:2000;
}

.modal-box{
    width:90%;
    max-width:550px;

    background:#111827;

    border:1px solid #334155;

    border-radius:20px;

    padding:30px;

    text-align:center;
}

.close{
    float:right;
    font-size:22px;
    cursor:pointer;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:800px){

    .hero{
        flex-direction:column-reverse;
        text-align:center;
        padding:35px;
    }

